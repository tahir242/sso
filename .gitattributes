* text=auto eol=lf

# Windows scripts run on the server from cmd: keep CRLF line endings.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

*.png binary
*.ico binary
*.jpg binary
*.webp binary
*.woff2 binary

/.github export-ignore
/tests export-ignore
/phpunit.xml export-ignore
/CHANGELOG.md export-ignore
