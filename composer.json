{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tahir242/sso",
    "type": "project",
    "description": "Self-hosted single sign-on and identity portal: OpenID Connect provider, Active Directory sign-in, two-step verification, access requests and reviews, built on Laravel and Filament.",
    "keywords": [
        "sso",
        "single-sign-on",
        "openid-connect",
        "oidc",
        "oauth2",
        "identity-provider",
        "active-directory",
        "ldap",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/tahir242/sso",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/tahir242/sso/issues",
        "source": "https://github.com/tahir242/sso",
        "security": "https://github.com/tahir242/sso/security/policy"
    },
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.1",
        "dedoc/scramble": "^0.13.53",
        "directorytree/ldaprecord-laravel": "^4.0",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "laravel-notification-channels/webpush": "^13.0",
        "laravel/framework": "^13.17",
        "laravel/passport": "^13.10",
        "laravel/tinker": "^3.0",
        "pragmarx/google2fa": "^9.1",
        "predis/predis": "^3.0",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.5",
        "spatie/laravel-settings": "^3.10",
        "tahir242/sso-client": "^1.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "sso-client",
            "type": "path",
            "url": "packages/sso-client",
            "options": {
                "symlink": false
            }
        }
    ]
}
