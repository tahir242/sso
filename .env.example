# SSO - environment template.
# Copy to .env on the server and fill in the blanks. Values marked "secret" also
# go in the IT password safe. Everything else (mail, Active Directory, WhatsApp,
# two-step verification, session lengths, branding) is set in the admin console
# under Settings, not here.

APP_NAME="SSO"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sso.example.com
# secret: `php artisan key:generate` ONCE. It decrypts stored secrets; never change it.
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning

# SQL Server 2017 or later; a dedicated login that owns only this database.
DB_CONNECTION=sqlsrv
DB_HOST=
DB_PORT=
DB_DATABASE=SSO
DB_USERNAME=
# secret
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Nightly encrypted backup (`php artisan sso:backup`, 01:30).
SSO_BACKUP_PATH=
# secret: 16+ characters
SSO_BACKUP_PASSWORD=
# Folder as seen by the SQL Server machine; leave empty if the DBAs back up the database.
SSO_BACKUP_SQLSERVER_PATH=
SSO_BACKUP_KEEP=14

VITE_APP_NAME="${APP_NAME}"
